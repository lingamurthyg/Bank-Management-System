# Environment Variables Configuration Template
# Copy this file to .env and fill in the values for your Azure environment

# ============================================================================
# Database Configuration
# ============================================================================
SQL_CONNECTION_STRING="Server=tcp:your-server.database.windows.net,1433;Database=BankDB;User ID=your-user;Password=your-password;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10;"
SQL_SERVER="your-server.database.windows.net"
SQL_DATABASE="BankDB"
SQL_USER="your-user"
SQL_PASSWORD="your-password"

# ============================================================================
# Azure Storage Configuration
# ============================================================================
AZURE_STORAGE_BLOB_ENDPOINT="https://yourstorageaccount.blob.core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="bank-data"

# ============================================================================
# Azure Service Bus Configuration
# ============================================================================
AZURE_SERVICEBUS_NAMESPACE="your-servicebus-namespace.servicebus.windows.net"
AZURE_SERVICEBUS_QUEUE_NAME="bank-audit-queue"

# ============================================================================
# Azure App Configuration
# ============================================================================
AZURE_APPCONFIG_ENDPOINT="https://your-appconfig.azconfig.io"

# ============================================================================
# Azure AD Authentication
# ============================================================================
AZURE_AD_TENANT_ID="your-tenant-id"
AZURE_AD_CLIENT_ID="your-client-id"

# ============================================================================
# Application Settings
# ============================================================================
ASPNETCORE_ENVIRONMENT="Production"
LOG_DIRECTORY="/app/logs"
STATE_DIRECTORY="/app/state"
CACHE_DIRECTORY="/app/cache"

# ============================================================================
# Azure Managed Identity (for AKS Workload Identity)
# ============================================================================
# These are automatically set by Azure when using Managed Identity
# AZURE_CLIENT_ID="managed-identity-client-id"
# AZURE_TENANT_ID="managed-identity-tenant-id"
# AZURE_FEDERATED_TOKEN_FILE="/var/run/secrets/azure/tokens/azure-identity-token"

# ============================================================================
# Optional: Development Overrides
# ============================================================================
# Uncomment for local development
# ASPNETCORE_ENVIRONMENT="Development"
# SQL_CONNECTION_STRING="Server=localhost;Database=BankDB;Integrated Security=true;"
