{
  "ConnectionStrings": {
    "OpenBankLocal": "Server=${SQL_SERVER};Database=${SQL_DATABASE};User Id=${SQL_USER};Password=${SQL_PASSWORD};MultipleActiveResultSets=true;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Azure": {
    "StorageAccount": {
      "BlobEndpoint": "${AZURE_STORAGE_BLOB_ENDPOINT}",
      "ContainerName": "${AZURE_STORAGE_CONTAINER_NAME}"
    },
    "ServiceBus": {
      "Namespace": "${AZURE_SERVICEBUS_NAMESPACE}",
      "QueueName": "${AZURE_SERVICEBUS_QUEUE_NAME}"
    },
    "AppConfiguration": {
      "Endpoint": "${AZURE_APPCONFIG_ENDPOINT}"
    }
  },
  "AllowedHosts": "*"
}
